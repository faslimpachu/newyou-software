generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Patient {
  mr               String    @id
  consultationType String
  patientName      String
  parentName       String
  gender           String
  mobileNumber     String
  email            String?
  address          String
  district         String
  state            String
  pinCode          String
  dob              DateTime?
  age              Int?
  bloodGroup       String?
  status           String?

  emergencyContactName       String?
  emergencyContactPhone      String?
  emergencyContactRelation   String?
  allergies                  String?
  conditions                 String?
  medications                String?
  smoking                    String?
  alcohol                    String?
  exercise                   String?
  diet                       String?

  createdAt        DateTime  @default(now())

  visits           Visit[]
  opSheets         OPSheet[]
  prescriptions    Prescription[]
  nutritionAssessments NutritionAssessment[]
  ayurcareTreatments  AyurcareTreatment[]
  followUps        FollowUp[]
  documents        Document[]

  @@map("patients")
}

model Visit {
  id                  String   @id
  patientMr           String
  doctor              String?
  dietitian           String?
  appointmentDate     DateTime?
  appointmentTimeSlot String?
  status              String   @default("Waiting")
  center              String?
  createdAt           DateTime @default(now())

  patient             Patient       @relation(fields: [patientMr], references: [mr], onDelete: Cascade)
  opSheet             OPSheet?

  @@map("visits")
}

model OPSheet {
  id                  String   @id @default(uuid())
  patientMr           String
  visitId             String   @unique
  clinicalExamination String?
  vitals              String?
  diagnosis           String?
  symptoms            String?
  status              String?
  createdAt           DateTime @default(now())

  patient             Patient     @relation(fields: [patientMr], references: [mr], onDelete: Cascade)
  visit               Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  prescription        Prescription?

  @@map("op_sheets")
}

model Prescription {
  id             String   @id @default(uuid())
  patientMr      String
  visitId        String
  opSheetId      String?  @unique
  diagnosis      String?
  medicines      String?
  advice         String?
  followUp       String?
  doctorSignature String?
  createdAt      DateTime @default(now())

  patient        Patient     @relation(fields: [patientMr], references: [mr], onDelete: Cascade)
  opSheet        OPSheet?    @relation(fields: [opSheetId], references: [id], onDelete: Cascade)

  @@map("prescriptions")
}

model NutritionAssessment {
  id              String    @id @default(uuid())
  patientMr       String
  assessmentDate  DateTime
  program         String?
  weight          Float?
  bmi             Float?
  bodyFat         Float?
  dietPlan        String?
  observations    String?
  recommendations String?
  notes           String?
  reviewDate      DateTime?
  dietitian       String?
  createdAt       DateTime  @default(now())

  patient Patient @relation(fields: [patientMr], references: [mr], onDelete: Cascade)

  @@map("nutrition_assessments")
}

model AyurcareTreatment {
  id             String    @id @default(uuid())
  patientMr      String
  diagnosis      String?
  treatmentPlan  String?
  medicines      String?
  procedures     String?
  therapies      String?
  advice         String?
  practitioner   String?
  reviewDate     DateTime?
  notes          String?
  createdAt      DateTime @default(now())

  patient Patient @relation(fields: [patientMr], references: [mr], onDelete: Cascade)

  @@map("ayurcare_treatments")
}

model FollowUp {
  id          String   @id @default(uuid())
  patientMr   String
  program     String?
  reviewDate  DateTime?
  dueDate     DateTime?
  assignedTo  String?
  priority    String?
  status      String?
  remarks     String?
  createdAt   DateTime @default(now())

  patient     Patient @relation(fields: [patientMr], references: [mr], onDelete: Cascade)

  @@map("follow_ups")
}

model Expense {
  id            String   @id @default(cuid())
  expenseNumber String   @unique
  date          String   // ISO yyyy-mm-dd
  category      String
  description   String
  amount        Float
  paymentMethod String
  paidTo        String
  remarks       String?
  receiptName   String?
  receiptDataUrl String?
  addedBy       String
  createdDate   String   // display date, set once
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("expenses")
}

model Invoice {
  id              Int      @id @default(autoincrement())
  invoiceNumber   String   @unique
  center          String
  billType        String
  patientName     String
  patientMrNumber String
  patientAge      String?
  patientDob      String?
  patientGender   String?
  patientBloodGroup String?
  patientAddress  String?
  patientContact  String?
  invoiceDate     String
  discount        Float     @default(0)
  tax             Float     @default(0)
  paid            Float     @default(0)
  paymentMethod   String?
  subtotal        Float?
  grandTotal      Float?
  balance         Float?
  status          String?
  createdAt       DateTime @default(now())

  items           InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId Int
  name      String
  quantity  Float
  rate      Float

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Document {
  id          String   @id @default(uuid())
  patientMr   String
  title       String?
  category    String?
  fileName    String
  filePath    String
  fileType    String?
  uploadedBy  String?
  remarks     String?
  uploadedAt  DateTime @default(now())

  patient     Patient @relation(fields: [patientMr], references: [mr], onDelete: Cascade)

  @@map("documents")
}

model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  passwordHash String
  role         String
  phone        String?
  centerType   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("users")
}

model MRSequence {
  id         String   @id @default("GLOBAL")
  lastNumber Int      @default(0)
  updatedAt  DateTime @default(now())

  @@map("mr_sequences")
}

model ProductSequence {
  id         String   @id @default("GLOBAL")
  lastNumber Int      @default(0)
  updatedAt  DateTime @default(now())

  @@map("product_sequences")
}

model VisitSequence {
  id         String   @id
  centerType String   @unique
  lastNumber Int      @default(0)
  updatedAt  DateTime @default(now())

  @@map("visit_sequences")
}

enum ReferenceType {
  PURCHASE_INVOICE
  SALE_INVOICE
  ADJUSTMENT
  PRESCRIPTION
  RETURN
}

// --- PMS Enums ---
enum TransactionType {
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_OUT
  EXPIRED
  DAMAGED
  LOST
}

enum PaymentMode {
  CASH
  BANK
  UPI
  CREDIT
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

// --- PMS Models ---
model ProductCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  products    Product[]

  @@map("product_categories")
}

model Supplier {
  id              String        @id @default(uuid())
  supplierName    String
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  gstNumber       String?
  openingBalance  Decimal       @default(0)
  status          SupplierStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())

  purchaseInvoices  PurchaseInvoice[]
  payments          SupplierPayment[]
  receipts          BatchReceipt[]

  @@map("suppliers")
}

model Product {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  sku           String?  @unique
  categoryId    String?
  unit          String   @default("pcs")
  purchasePrice Decimal
  sellingPrice  Decimal
  gstPercent    Decimal  @default(0)
  minimumStock  Int      @default(10)
  maximumStock  Int      @default(200)
  currentStock  Decimal  @default(0)
  imageUrl      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  category        ProductCategory?       @relation(fields: [categoryId], references: [id])
  invoiceItems    PurchaseInvoiceItem[]
  transactions    InventoryTransaction[]
  batches         ProductBatch[]

  @@map("products")
}

enum BatchReceiptSource {
  PURCHASE
  ADJUSTMENT
  OPENING
}

model ProductBatch {
  id         String   @id @default(uuid())
  productId  String
  batchNumber String
  expiryDate  DateTime?
  quantity   Decimal  @default(0)
  createdAt  DateTime  @default(now())

  product    Product           @relation(fields: [productId], references: [id])
  receipts   BatchReceipt[]
  transactions InventoryTransaction[]

  @@index([productId])
  @@index([expiryDate])
  @@unique([productId, batchNumber])
  @@map("product_batches")
}

model BatchReceipt {
  id                String   @id @default(uuid())
  batchId           String
  supplierId        String
  purchaseInvoiceId String?
  sourceType        BatchReceiptSource
  sourceId          String?
  quantity          Decimal
  remainingQuantity Decimal
  purchaseRate      Decimal
  createdAt         DateTime  @default(now())

  batch           ProductBatch   @relation(fields: [batchId], references: [id])
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  @@index([batchId])
  @@index([purchaseInvoiceId])
  @@index([supplierId])
  @@map("batch_receipts")
}

model PurchaseInvoice {
  id            String         @id @default(uuid())
  invoiceNumber String         @unique
  invoiceDate   DateTime
  supplierId    String
  paymentMode   PaymentMode?
  dueDate       DateTime?
  notes         String?
  subtotal      Decimal
  tax           Decimal
  grandTotal    Decimal
  paid          Decimal        @default(0)
  balance       Decimal
  status        PaymentStatus  @default(PENDING)
  createdAt     DateTime       @default(now())

  supplier       Supplier           @relation(fields: [supplierId], references: [id])
  items          PurchaseInvoiceItem[]
  payments       SupplierPayment[]
  receipts       BatchReceipt[]

  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id           String @id @default(uuid())
  invoiceId    String
  productId    String
  quantity     Decimal
  purchaseRate Decimal
  amount       Decimal
  batchNumber  String?
  expiryDate   DateTime?

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])

  @@map("purchase_invoice_items")
}

model SupplierPayment {
  id            String         @id @default(uuid())
  paymentNumber String         @unique
  supplierId    String
  invoiceId     String?
  amount        Decimal
  paymentDate   DateTime
  paymentMode   PaymentMode?
  reference     String?
  notes         String?
  createdAt     DateTime       @default(now())

  supplier   Supplier        @relation(fields: [supplierId], references: [id])
  invoice    PurchaseInvoice? @relation(fields: [invoiceId], references: [id])

  @@map("supplier_payments")
}

model InventoryTransaction {
  id           String            @id @default(uuid())
  productId    String
  batchId      String?
  type         TransactionType
  quantity     Decimal
  referenceType ReferenceType?
  referenceId  String?
  notes        String?
  createdAt    DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id])
  batch  ProductBatch? @relation(fields: [batchId], references: [id])

  @@map("inventory_transactions")
  @@index([productId, type])
  @@index([referenceType, referenceId])
  @@index([batchId])
}

model Sequence {
  id         String   @id
  name       String   @unique
  lastNumber Int      @default(0)
  updatedAt  DateTime @default(now())

  @@map("sequences")
}
